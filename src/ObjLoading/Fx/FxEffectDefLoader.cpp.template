    enum class SampleChannel
    {
        RGBA,
        SIZE_0,
        SIZE_1,
        SCALE,
        ROTATION,
        NONE,
    };

    struct VisualSampleRouting
    {
        SampleChannel rgba;
        SampleChannel size0;
        SampleChannel size1;
        SampleChannel scale;
        SampleChannel rotation;

        std::array<SampleChannel, 5> GetChannels() const
        {
            return {rgba, size0, size1, scale, rotation};
        }
    };

    template<typename To, typename From> void CopyCanonicalRange(To& destination, const From& source)
    {
        if (source.amplitude >= 0)
        {
            destination.base = source.base;
            destination.amplitude = source.amplitude;
        }
        else
        {
            destination.base = source.base + source.amplitude;
            destination.amplitude = -source.amplitude;
        }
    }

    void CopyScaledRange(FxFloatRange& destination, const fx::FxEditorRange<float>& source, const float scale)
    {
        destination.base = source.base * scale;
        destination.amplitude = source.amplitude * scale;
    }

